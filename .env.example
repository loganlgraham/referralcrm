MONGODB_URI=
# MongoDB TLS/SSL configuration (optional)
# Set to 'true' to allow invalid certificates (self-signed, expired, etc.)
# WARNING: Only use for troubleshooting or non-production environments
# MONGODB_ALLOW_INVALID_CERTS=false
NEXTAUTH_URL=
NEXTAUTH_SECRET=
ADMIN_SIGNUP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMTP alternative (omit if using Resend)
EMAIL_SERVER=
EMAIL_FROM=
# Resend (preferred on Vercel)
RESEND_API_KEY=
RESEND_INBOUND_SECRET=
# Alternate inbound webhook secrets (optional; prefer RESEND_INBOUND_SECRET)
# RESEND_INBOUND_WEBHOOK_SECRET=
# RESEND_WEBHOOK_SECRET=
# Signing secret for the delivery event webhook at /api/email-events.
# Falls back to RESEND_WEBHOOK_SECRET when unset.
RESEND_EVENTS_WEBHOOK_SECRET=
# Who gets copied on referral notifications, fee breakdowns, and intro emails.
# Comma or semicolon separated. No default: unset means the coordinator copy is skipped.
REFERRAL_NOTIFICATION_RECIPIENTS=
# Optional AI fallback for inbound email parsing when label extraction fails
# OPENAI_API_KEY=

# Cron routes (local testing or non-Vercel triggers; Vercel Cron sends Authorization: Bearer)
# CRON_SECRET=

GCP_STORAGE_CLIENT_EMAIL=
GCP_STORAGE_PRIVATE_KEY=
INBOUND_EMAIL_BUCKET=
TZ=America/Denver
# Optional feature flags
UPLOAD_MAX_SIZE_MB=25
# Import service config
IMPORTS_STORAGE_BUCKET=
# Webhook secrets
WEBHOOK_SECRET=

# Playwright e2e credentials live in .env.test.local (see .env.test.example).
# Do not put those logins here.
