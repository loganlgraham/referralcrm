{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/follow-up-reminders?frequency=daily",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/follow-up-reminders?frequency=weekly",
      "schedule": "0 14 * * MON"
    }
  ]
}
