{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/closing-reminders",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/auto-update-reminders",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/daily-market-brief",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/scheduled-reports",
      "schedule": "0 * * * *"
    }
  ]
}
